# ─── Beyound — variáveis de ambiente (exemplo) ───────────────────────────────
# Copie para .env e preencha com os valores reais.

# Segurança da API — gere uma chave forte (ex: openssl rand -hex 32)
API_KEY=replace-me

# URL pública do servidor (IP ou domínio onde o container está acessível)
SERVER_URL=http://SEU_IP:8787

# Configurações gerais
NODE_ENV=production
PORT=8787
AUTH_FOLDER=auth

# Caminhos dos bancos de dados (dentro do container)
WEBHOOK_DB_PATH=/app/data/webhooks.sqlite
INTEGRATIONS_DB_PATH=/app/data/integrations.sqlite
MESSAGES_DB_PATH=/app/data/messages.sqlite

# Funcionalidades
PAIRING_CODE_ENABLED=true
# SSRF protection: mantenha false em produção. true apenas em redes internas controladas.
ALLOW_PRIVATE_NETWORK_WEBHOOKS=false
ALLOW_PRIVATE_NETWORK_INTEGRATIONS=false
WEBHOOK_EMBEDDED_WORKER_ENABLED=true
BAILEYS_LOG=false

# Segredo para validar webhooks do Chatwoot (opcional)
# CHATWOOT_WEBHOOK_SECRET=

# Chave para assinar URLs de mídia (gerada automaticamente se vazia)
# MEDIA_SIGNED_URL_SECRET=
