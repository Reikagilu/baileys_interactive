# Beyound configuration
# Copy this file to .env and replace every placeholder used by your deployment.

# Keeps Docker volume names stable if the checkout folder is renamed.
COMPOSE_PROJECT_NAME=beyound

# Required in production. Generate with: openssl rand -hex 32
API_KEY=replace-me
# Optional scoped-key mode. When set, keys should carry only required scopes.
# API_KEYS_JSON={"automation-key":{"key":"replace-me","scopes":["instances:*","messages:send"]}}

# Public HTTPS URL used to generate callback and media URLs.
SERVER_URL=http://localhost:8787
NODE_ENV=production
PORT=8787
AUTH_FOLDER=auth

# Persistent paths inside the container
WEBHOOK_DB_PATH=/app/data/webhooks.sqlite
INTEGRATIONS_DB_PATH=/app/data/integrations.sqlite
MESSAGES_DB_PATH=/app/data/messages.sqlite
AUDIT_LOG_PATH=/app/data/audit.log

# Authentication and pairing
PAIRING_CODE_ENABLED=true
PAIRING_DEFAULT_COUNTRY_CODE=55
PAIRING_FORCE_FRESH_SESSION=false
WHATSAPP_AUTO_RESET_CORRUPT_AUTH=false
BAILEYS_LOG=false

# Public exposure: keep false unless intentionally publishing these endpoints.
PUBLIC_DOCS_ENABLED=false
PUBLIC_METRICS_ENABLED=false
PUBLIC_READY_ENABLED=false
TRUST_PROXY=false
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=15552000

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1200
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=240

# SSRF protection. Enable only for controlled internal networks.
ALLOW_PRIVATE_NETWORK_WEBHOOKS=false
ALLOW_PRIVATE_NETWORK_INTEGRATIONS=false
INTEGRATIONS_REQUEST_TIMEOUT_MS=8000

# Webhook delivery
WEBHOOK_EMBEDDED_WORKER_ENABLED=true
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_DELAY_MS=2000
WEBHOOK_RETRY_MAX_DELAY_MS=30000
WEBHOOK_REQUEST_TIMEOUT_MS=8000
WEBHOOK_MAX_DELIVERY_HISTORY=5000
WEBHOOK_PURGE_INTERVAL_MS=60000
WEBHOOK_WORKER_POLL_MS=500
WEBHOOK_WORKER_BATCH_SIZE=25
WEBHOOK_WORKER_LOCK_MS=30000
WEBHOOK_DLQ_RETENTION_MS=604800000
# WEBHOOK_DEFAULT_SECRET=generate-a-dedicated-secret
WEBHOOK_INCLUDE_INCOMING_MEDIA_BASE64=false
WEBHOOK_INCLUDE_INCOMING_VIDEO_BASE64=false
WEBHOOK_INCOMING_MEDIA_BASE64_MAX_BYTES=2097152
WEBHOOK_INCOMING_VIDEO_BASE64_MAX_BYTES=5242880

# Protect public Chatwoot callback routes.
# Generate with: openssl rand -hex 32
# CHATWOOT_WEBHOOK_SECRET=replace-with-a-dedicated-secret
CHATWOOT_REQUEST_TIMEOUT_MS=30000
CHATWOOT_REQUEST_RETRIES=2
CHATWOOT_REQUEST_RETRY_DELAY_MS=1500
CHATWOOT_MEDIA_MAX_BYTES=26214400
CHATWOOT_SYNC_MSG_DELAY_MS=250
CHATWOOT_SYNC_BATCH_SIZE=50
CHATWOOT_SYNC_BATCH_PAUSE_MS=1000

# Signed, expiring media URLs. Defaults to API_KEY if omitted.
# MEDIA_SIGNED_URL_SECRET=replace-with-a-different-random-secret
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# Message retention and idempotency
MESSAGES_HISTORY_TTL_DAYS=30
MESSAGES_CLEANUP_INTERVAL_MS=21600000
MESSAGES_MAX_PER_CHAT=2000
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_ENTRIES=5000

# Observability
REQUEST_LOGS_ENABLED=true
AUDIT_MAX_IN_MEMORY_EVENTS=500
ALERT_MAX_PENDING_DELIVERIES=1000
ALERT_MAX_FAILED_DELIVERIES=200
ALERT_MAX_OLDEST_PENDING_AGE_SECONDS=300
ALERT_MIN_CONNECTED_INSTANCES=1

# Control-plane media limits and retention
CHAT_INLINE_MEDIA_MAX_BYTES=1572864
CHAT_VIDEO_MAX_BYTES=8388608
CHAT_MEDIA_RETENTION_MS=7776000000
