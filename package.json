{
  "name": "beyound",
  "version": "1.0.0",
  "description": "Self-hosted multi-instance WhatsApp gateway with durable webhooks, Chatwoot and n8n integrations.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:local": "bash ./build.sh",
    "docker:rebuild": "bash ./docker-rebuild.sh",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker:webhooks": "node dist/workers/webhook-delivery-worker.js",
    "start:stack": "node dist/index.js & node dist/workers/webhook-delivery-worker.js",
    "postinstall": "node scripts/patch-baileys.mjs",
    "docs:check": "npm run build && node --test dist/tests/openapi-contract.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "baileys": "git+https://github.com/rsalcara/InfiniteAPI",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "https-proxy-agent": "^7.0.6",
    "protobufjs": "^8.7.1",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.20.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reikagilu/baileys_interactive.git"
  },
  "bugs": {
    "url": "https://github.com/Reikagilu/baileys_interactive/issues"
  },
  "homepage": "https://github.com/Reikagilu/baileys_interactive#readme"
}
