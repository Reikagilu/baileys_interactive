{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "noEmitOnError": false,
    "allowJs": false
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/middleware/api-auth.ts",
    "src/middleware/request-context.ts",
    "src/routes/integrations.ts",
    "src/services/chatwoot-bridge.ts",
    "src/services/chatwoot-sync-store.ts",
    "src/services/chatwoot-tracking.ts",
    "src/services/integrations.ts",
    "src/services/message-store.ts",
    "src/services/whatsapp.ts"
  ],
  "exclude": [
    "src/routes/instances.ts",
    "src/routes/messages.ts",
    "src/routes/webhooks.ts",
    "src/routes/chats.ts",
    "src/routes/ops.ts",
    "src/services/webhooks.ts",
    "src/services/idempotency.ts",
    "src/services/audit-log.ts",
    "src/services/instance-config.ts",
    "src/workers/webhook-delivery-worker.ts"
  ]
}
